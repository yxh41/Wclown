<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>defaults</key><string>com.zlhkf.wclown</string>
	<key>items</key>
	<array>
		<dict>
			<key>cell</key><string>PSGroupCell</string>
			<key>label</key><string>小丑功能</string>
			<key>footerText</key><string>所有消息修改仅在本次微信运行期间生效，重启自动失效。颠倒阴阳只调整消息左右位置，不改变真实发送者。修改转账只影响本机显示。</string>
		</dict>
		<dict>
			<key>cell</key><string>PSToggleSwitchCell</string>
			<key>label</key><string>启用小丑功能</string>
			<key>id</key><string>enabled</string>
			<key>key</key><string>enabled</string>
			<key>default</key><false/>
		</dict>
		<dict>
			<key>cell</key><string>PSToggleSwitchCell</string>
			<key>label</key><string>聊天文字</string>
			<key>id</key><string>textEnabled</string>
			<key>key</key><string>textEnabled</string>
			<key>default</key><false/>
		</dict>
		<dict>
			<key>cell</key><string>PSToggleSwitchCell</string>
			<key>label</key><string>聊天图片</string>
			<key>id</key><string>imageEnabled</string>
			<key>key</key><string>imageEnabled</string>
			<key>default</key><false/>
		</dict>
		<dict>
			<key>cell</key><string>PSToggleSwitchCell</string>
			<key>label</key><string>消息时间</string>
			<key>id</key><string>messageTimeEnabled</string>
			<key>key</key><string>messageTimeEnabled</string>
			<key>default</key><false/>
		</dict>
		<dict>
			<key>cell</key><string>PSToggleSwitchCell</string>
			<key>label</key><string>消息排序</string>
			<key>id</key><string>messageSortEnabled</string>
			<key>key</key><string>messageSortEnabled</string>
			<key>default</key><false/>
		</dict>
		<dict>
			<key>cell</key><string>PSToggleSwitchCell</string>
			<key>label</key><string>聊天时间</string>
			<key>id</key><string>chatTimeEnabled</string>
			<key>key</key><string>chatTimeEnabled</string>
			<key>default</key><false/>
		</dict>
		<dict>
			<key>cell</key><string>PSToggleSwitchCell</string>
			<key>label</key><string>颠倒阴阳</string>
			<key>id</key><string>yinYangEnabled</string>
			<key>key</key><string>yinYangEnabled</string>
			<key>default</key><false/>
		</dict>
		<dict>
			<key>cell</key><string>PSToggleSwitchCell</string>
			<key>label</key><string>修改转账</string>
			<key>id</key><string>transferAmountEnabled</string>
			<key>key</key><string>transferAmountEnabled</string>
			<key>default</key><false/>
		</dict>
		<dict>
			<key>cell</key><string>PSToggleSwitchCell</string>
			<key>label</key><string>退出保持</string>
			<key>id</key><string>transferPersistOnExitChat</string>
			<key>key</key><string>transferPersistOnExitChat</string>
			<key>default</key><false/>
		</dict>
		<dict>
			<key>cell</key><string>PSGroupCell</string>
			<key>label</key><string>入口</string>
			<key>footerText</key><string>长按菜单入口：在微信长按消息的原生菜单里追加「小丑」。悬浮入口：屏幕角落常驻「丑」按钮，作为备用入口。两者默认开启；老版本若关过会残留为关，请用下方「恢复默认设置」清除。</string>
		</dict>
		<dict>
			<key>cell</key><string>PSToggleSwitchCell</string>
			<key>label</key><string>长按菜单入口</string>
			<key>id</key><string>menuEntryEnabled</string>
			<key>key</key><string>menuEntryEnabled</string>
			<key>default</key><true/>
		</dict>
		<dict>
			<key>cell</key><string>PSToggleSwitchCell</string>
			<key>label</key><string>悬浮入口</string>
			<key>id</key><string>floatingEntryEnabled</string>
			<key>key</key><string>floatingEntryEnabled</string>
			<key>default</key><true/>
		</dict>
		<dict>
			<key>cell</key><string>PSGroupCell</string>
			<key>label</key><string>开发</string>
			<key>footerText</key><string>诊断 Hook 开启后，下次启动微信会在日志打印候选类/selector 存在性（idevicesyslog 可见）。</string>
		</dict>
		<dict>
			<key>cell</key><string>PSToggleSwitchCell</string>
			<key>label</key><string>启用诊断 Hook</string>
			<key>id</key><string>diagnosticHooksEnabled</string>
			<key>key</key><string>diagnosticHooksEnabled</string>
			<key>default</key><false/>
		</dict>
		<dict>
			<key>cell</key><string>PSButtonCell</string>
			<key>label</key><string>恢复默认设置</string>
			<key>action</key><string>resetSettings</string>
			<key>confirm</key><string>确定恢复所有开关为默认？长按菜单入口与悬浮入口会回到开启，其余覆盖类回到关闭。仅清空本机设置，不影响聊天记录。</string>
		</dict>
	</array>
</dict>
</plist>
